{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geomotion:schema:common:1",
  "$defs": {
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nonEmptyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
